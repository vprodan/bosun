+	if (status == SQLITE_OK) status = sqlite3_db_config(db->db_handle, SQLITE_DBCONFIG_DQS_DML, dqs, NULL);
+	if (status == SQLITE_OK) status = sqlite3_db_config(db->db_handle, SQLITE_DBCONFIG_ENABLE_LOAD_EXTENSION, allow_extension, NULL);
+	if (status != SQLITE_OK) {
