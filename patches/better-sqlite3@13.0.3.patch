+	REQUIRE_DATABASE_OPEN(db);
+	REQUIRE_DATABASE_NOT_BUSY(db);
+	REQUIRE_DATABASE_NO_ITERATORS(db);
+	if (!callback.IsNull() && !callback.IsFunction()) return ThrowTypeError(info.Env(), "Expected an authorizer function or null");
