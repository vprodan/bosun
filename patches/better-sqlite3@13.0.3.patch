+int Database::Authorize(void* context, int action, const char* p1, const char* p2, const char* database, const char* trigger) {
+	Database* db = static_cast<Database*>(context);
+	Napi::Env env = db->authorizer.Env();
+	if (db->authorizing || db->was_js_error || env.IsExceptionPending()) return SQLITE_DENY;
+	Napi::HandleScope scope(env);
+	const char* strings[] = { p1, p2, database, trigger };
+	napi_value args[5];
+	args[0] = Napi::Number::New(env, action);
+	for (size_t i = 0; i < 4; ++i) {
+		args[i + 1] = strings[i] ? StringFromUtf8(env, strings[i], -1) : env.Null();
+	}
+	if (env.IsExceptionPending()) {
+		db->was_js_error = true;
+		return SQLITE_DENY;
+	}
+	db->authorizing = true;
+	Napi::Value result = SafeCall(env, db->authorizer.Value(), env.Undefined(), 5, args);
+	db->authorizing = false;
+	if (env.IsExceptionPending()) {
+		db->was_js_error = true;
+		return SQLITE_DENY;
+	}
+	if (!result.IsEmpty() && result.IsNumber()) {
+		double value = result.As<Napi::Number>().DoubleValue();
+		if (value == SQLITE_OK || value == SQLITE_DENY || value == SQLITE_IGNORE) return static_cast<int>(value);
+	}
+	ThrowTypeError(env, "Authorizer must synchronously return SQLITE_OK, SQLITE_DENY, or SQLITE_IGNORE");
+	db->was_js_error = true;
+	return SQLITE_DENY;
