# bosun config. Copied to ~/.bosun/config.env on first run; edit that copy (`bosun config`).
# Environment variables with the same names override it.

# ── Hosts ────────────────────────────────────────────────────────────────
HOSTS=auto                       # claude | codex | claude,codex | auto (= whichever are installed)

# ── Local executor (Ollama) ─────────────────────────────────────────────
LOCAL_MODEL=qwen3.6:35b-a3b-coding-nvfp4   # MLX, 22 GB, MoE 3B active, SWE-bench Verified 73.4
LOCAL_FALLBACK=devstral-small-2:24b        # other model family, 15 GB, 65.8
LOCAL_HARNESS=auto               # claude | codex | auto (= claude if installed)
CTX=65536
OLLAMA_URL=http://127.0.0.1:11434
LOCAL_MAX_TURNS=40
WATCH=auto                       # auto = executors run in a watchable Orca split when inside Orca | off
RUN_TIMEOUT_MIN=30

# ── Roles: ROLE_<ROLE>_<HOST>=model[:effort] ────────────────────────────
ROLE_ARCHITECT_CLAUDE=opus:high
ROLE_ARCHITECT_CODEX=gpt-6-astra:high
ROLE_SCOUT_CLAUDE=haiku
ROLE_SCOUT_CODEX=gpt-6-luna:low
ROLE_WORKER_CLAUDE=sonnet
ROLE_WORKER_CODEX=gpt-6-luna:high
ROLE_TESTER_CLAUDE=sonnet
ROLE_TESTER_CODEX=gpt-6-luna:high
ROLE_DEBUGGER_CLAUDE=sonnet
ROLE_DEBUGGER_CODEX=gpt-6-luna:high
ROLE_REVIEWER_CLAUDE=sonnet      # same-vendor fallback when the other CLI is missing
ROLE_REVIEWER_CODEX=gpt-6-luna:high

# ── Cross-vendor ─────────────────────────────────────────────────────────
REVIEW_BY_CODEX=gpt-6-sol:high   # `bosun review` from a Claude session
REVIEW_BY_CLAUDE=opus:high       # `bosun review` from a Codex session
WORKER_BY_CODEX=gpt-6-luna:high  # bosun run -e codex (ChatGPT plan)
WORKER_BY_CLAUDE=sonnet          # bosun run -e claude (Claude plan)

# ── Router (Kev) ─────────────────────────────────────────────────────────
ROUTER_RUN=jaredpalmer/kev-0.8b
ROUTER_PORT=8009
ROUTER_URL=                      # empty = http://127.0.0.1:ROUTER_PORT
ROUTER_MIN_CONF=0.5
ROUTER_TIMEOUT=1.5

# ── Memory ───────────────────────────────────────────────────────────────
MEMORY_URL=                      # empty = local SQLite (~/.bosun/memory.db); http://host:8788 = a `bosun serve memory`
MEMORY_TOKEN=                    # sent as a Bearer token when set (v1 servers ignore it; auth comes later)
MEMORY_LINKED_PROJECTS=          # comma-separated project ids you can also read (`bosun memory stats` shows this one's)
MEMORY_SESSION_TTL_DAYS=7
MEMORY_PURGE_AFTER_DAYS=90       # archived memories older than this are purged by `bosun memory prune`
CLAUDE_MEM=on                    # off = don't read claude-mem
CLAUDE_MEM_DB=                   # empty = ~/.claude-mem/claude-mem.db (opened read-only)
CONTEXT_HOOK_BUDGET=400          # ~tokens of memory the prompt hook may add
CONTEXT_HOOK_MIN_SCORE=0.35
CONTEXT_HOOK_MIN_TERMS=2         # a note must contain at least this many distinct words of the prompt
CONTEXT_ITEM_CHARS=400
MCP_MAX_CHARS=20000

# ── LLM router (consolidation, memory add --auto) ────────────────────────
LLM_PROVIDERS=ollama             # fallback chain: ollama, openai (an OpenAI-compatible server: mlx_lm.server, LM Studio)
LLM_MODEL=                       # empty = LOCAL_MODEL
LLM_OPENAI_URL=http://127.0.0.1:8080
LLM_REMOTE=off                   # claude = claude -p (haiku) as a last resort, never for private content
LLM_TIMEOUT_S=60
LLM_RETRIES=1                    # on timeouts and connection errors only

# ── Split setup (optional; see README "Split setup") ─────────────────────
SERVE_BIND=                      # bosun serve: empty = this Mac's Tailscale IPv4; never 0.0.0.0 unless you set it
SERVE_ALLOW=                     # source IPs allowed; empty = 127.0.0.1/32,100.64.0.0/10 + SERVE_BIND's subnet
MEMORY_PORT=8788
REMOTE_TIMEOUT_MS=5000           # CLI and MCP calls to MEMORY_URL
REMOTE_HOOK_TIMEOUT_MS=300       # the prompt hook's memory part; it fails open
